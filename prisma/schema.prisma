generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String
  passwordHash    String?
  role            String          @default("Software Engineer")
  avatar          String          @default("")
  githubUsername  String?
  githubId        String?         @unique
  githubToken     String?
  createdAt       DateTime        @default(now())
  ownedProjects   Project[]       @relation("ProjectOwner")
  memberships     ProjectMember[]
  assignedTasks   Task[]          @relation("TaskAssignee")
  assignedIssues  Issue[]         @relation("IssueAssignee")
  activities      Activity[]
}

model Project {
  id          String          @id @default(cuid())
  ownerId     String
  name        String
  key         String
  description String          @default("")
  color       String          @default("#2563eb")
  gitRepo     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  tasks       Task[]
  issues      Issue[]
  activities  Activity[]
  github      GitHubIntegration?
  webhooks    WebhookEvent[]
  commits     Commit[]
  pullRequests PullRequest[]
  workflowRuns WorkflowRun[]

  @@unique([ownerId, key])
  @@index([ownerId, updatedAt])
}

model ProjectMember {
  projectId String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id             String   @id @default(cuid())
  projectId      String
  assigneeId     String?
  title          String
  description    String   @default("")
  stage          String   @default("todo")
  priority       String   @default("medium")
  dueDate        String?
  tags           Json     @default("[]")
  subtasks       Json     @default("[]")
  githubBranch   String?
  githubPR       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee       User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  linkedIssues   Issue[]

  @@index([projectId, stage])
}

model Issue {
  id                String   @id @default(cuid())
  projectId         String
  assigneeId        String?
  linkedTaskId      String?
  title             String
  description       String   @default("")
  reproductionSteps Json     @default("[]")
  expectedBehavior  String   @default("")
  actualBehavior    String   @default("")
  severity          String   @default("minor")
  status            String   @default("open")
  environment       String   @default("")
  reporterName      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee          User?    @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  linkedTask        Task?    @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  userId    String?
  type      String
  title     String
  details   String?
  timestamp DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, timestamp])
}

model GitHubIntegration {
  id          String   @id @default(cuid())
  projectId   String   @unique
  repoUrl     String
  owner       String
  repoName    String
  webhookSecret String
  defaultBranch String @default("main")
  autoSync    Boolean  @default(true)
  lastSyncedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id        String   @id @default(cuid())
  projectId String
  event     String
  action    String   @default("")
  sender    String   @default("")
  status    String   @default("received")
  payload   Json
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Commit {
  id            String   @id @default(cuid())
  projectId     String
  sha           String
  message       String
  authorName    String
  authorEmail   String   @default("")
  authorAvatar  String   @default("")
  branch        String   @default("")
  htmlUrl       String?
  committedAt   DateTime
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sha])
  @@index([projectId, committedAt])
}

model PullRequest {
  id             String   @id @default(cuid())
  projectId      String
  number         Int
  title          String
  description    String   @default("")
  authorName     String
  authorAvatar   String   @default("")
  githubUsername String   @default("")
  sourceBranch   String
  targetBranch   String
  status         String
  htmlUrl        String?
  createdAt      DateTime
  updatedAt      DateTime
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([projectId, status])
}

model WorkflowRun {
  id              String   @id @default(cuid())
  projectId       String
  runNumber       Int
  name            String
  status          String
  branch          String
  commitSha       String   @default("")
  commitMessage   String   @default("")
  authorName      String   @default("")
  htmlUrl         String?
  startedAt       DateTime
  completedAt     DateTime?
  details         Json     @default("{}")
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, runNumber])
  @@index([projectId, startedAt])
}
